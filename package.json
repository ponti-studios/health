{
  "name": "health",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js --port=${PORT:-3000}",
    "lint": "oxlint app --fix",
    "format": "oxfmt app --write",
    "test": "vitest --run --passWithNoTests",
    "test:unit": "vitest --run --passWithNoTests --coverage",
    "test:e2e": "playwright test",
    "test:unit:watch": "vitest --watch",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "typecheck": "react-router typegen && tsc"
  },
  "dependencies": {
    "@ponti-studios/ui": "3.0.1",
    "@react-router/node": "^8.2.0",
    "@react-router/serve": "^8.2.0",
    "@tanstack/react-query": "^5.101.3",
    "date-fns": "^4.4.0",
    "isbot": "^5.2.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.2.0",
    "sonner": "^2.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@react-router/dev": "^8.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "oxfmt": "0.56.0",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vite": "^8.1.5",
    "vite-plugin-devtools-json": "^1.1.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.30.3"
}
